# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# Required. Get this from https://resend.com/api-keys after creating a
# Resend account (their free tier is enough for a contact form).
RESEND_API_KEY=

# Optional. Where contact-form submissions get emailed. Defaults to
# deep@peoplefabrix.com if unset.
CONTACT_TO_EMAIL=deep@peoplefabrix.com

# Optional. The "from" address Resend sends as. Must be on a domain you've
# verified with Resend (Resend dashboard → Domains → add peoplefabrix.com
# and its DNS records) — until you do that, leave this unset and it falls
# back to Resend's shared test address (onboarding@resend.dev), which only
# works reliably for sending to the email address on your Resend account.
CONTACT_FROM_EMAIL=
